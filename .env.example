# Copie para .env (ignorado pelo git). Valores abaixo sao apenas para desenvolvimento local.
# Usados pelo docker-compose.yml (infra local).
POSTGRES_USER=billing_user
POSTGRES_PASSWORD=billing_pass
POSTGRES_DB=billing_ledger

# Usados pelos servicos .NET (sobrescrevem appsettings via variaveis de ambiente).
ConnectionStrings__Postgres=Host=localhost;Port=5433;Database=billing_ledger;Username=billing_user;Password=billing_pass
Payments__WebhookSecret=troque-este-valor
Jwt__SigningKey=troque-por-uma-chave-com-no-minimo-32-caracteres

# Usados pelo profile "app" do docker-compose.yml (servicos .NET em container).
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
JWT_SIGNING_KEY=troque-por-uma-chave-com-no-minimo-32-caracteres
PAYMENTS_WEBHOOK_SECRET=troque-este-valor

# Demo publica (Render + Neon, ver "Deploy gratuito" no README). Defina no painel do Render.
# ConnectionStrings__Postgres=Host=<host>.neon.tech;Database=neondb;Username=<usuario>;Password=<senha>;SSL Mode=Require
# Messaging__Transport=InMemory
# Swagger__Enabled=true
# Database__MigrateOnStartup=true
