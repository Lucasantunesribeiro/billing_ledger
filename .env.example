# Copie para .env (ignorado pelo git). Valores abaixo sao apenas para desenvolvimento local.
# Usados pelo docker-compose.yml (infra local).
POSTGRES_USER=billing_user
POSTGRES_PASSWORD=billing_pass
POSTGRES_DB=billing_ledger

# Usados pelos servicos .NET (sobrescrevem appsettings via variaveis de ambiente).
ConnectionStrings__Postgres=Host=localhost;Port=5433;Database=billing_ledger;Username=billing_user;Password=billing_pass
Payments__WebhookSecret=troque-este-valor
Jwt__SigningKey=troque-por-uma-chave-com-no-minimo-32-caracteres
